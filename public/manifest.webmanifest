{
  "name": "NutriPulse – Diet, Sugar & BP Tracker",
  "short_name": "NutriPulse",
  "description": "Snap food photos for instant calories, follow personalised diet plans and track blood sugar and blood pressure.",
  "id": "/",
  "start_url": "/#/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f7f6",
  "theme_color": "#0f9d74",
  "categories": ["health", "fitness", "food", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Scan food", "url": "/#/scan", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log blood sugar", "url": "/#/vitals/sugar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log blood pressure", "url": "/#/vitals/bp", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
