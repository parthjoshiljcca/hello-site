 ctx.beginPath();ctx.moveTo(-150,240);ctx.lineTo(-150,-20);ctx.quadraticCurveTo(-150,-150,0,-170);ctx.quadraticCurveTo(150,-150,150,-20);ctx.lineTo(150,240);ctx.fillStyle='rgba(255,138,31,.08)';ctx.fill();gs(4,OR,12);
