// ---------- primitives (line art: warm-white strokes, orange glow) ----------
const LN='rgba(243,236,228,.92)',DARK='rgba(18,12,9,.96)',GOLD='#ffb15c',LEM='#e8d64a',CHI='#5fbf3c',BLUE='#2f7fd6';
function eyeBig(x,y,s,a,t,look=0,angry=0){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.scale(s,s);ctx.beginPath();ctx.moveTo(-110,0);ctx.quadraticCurveTo(0,-80+20*angry,110,0);ctx.quadraticCurveTo(0,80,-110,0);ctx.fillStyle='rgba(243,236,228,.9)';ctx.fill();gs(5,LN);
 ctx.save();ctx.clip();ctx.beginPath();ctx.arc(look*30,0,44,0,7);ctx.fillStyle=OR;ctx.shadowColor=OR;ctx.shadowBlur=24;ctx.fill();ctx.shadowBlur=0;ctx.beginPath();ctx.arc(look*30,0,20,0,7);ctx.fillStyle='#120a05';ctx.fill();ctx.beginPath();ctx.arc(look*30-12,-12,8,0,7);ctx.fillStyle='#fff';ctx.fill();ctx.restore();
 if(angry>0){ctx.beginPath();ctx.moveTo(-100,-70);ctx.lineTo(60,-40);gs(8,OR,12)}ctx.restore()}
function house(x,y,s,a,crack){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.scale(s,s);ctx.beginPath();ctx.moveTo(-120,0);ctx.lineTo(0,-100);ctx.lineTo(120,0);ctx.lineTo(100,0);ctx.lineTo(100,130);ctx.lineTo(-100,130);ctx.lineTo(-100,0);ctx.closePath();ctx.fillStyle=DARK;ctx.fill();gs(5,LN);
 rr(-30,50,60,80,6);gs(4,OR,10);rr(-80,20,40,36,4);ctx.fillStyle='rgba(255,170,80,.5)';ctx.fill();rr(40,20,40,36,4);ctx.fill();
 if(crack>0){ctx.beginPath();ctx.moveTo(60,-48);ctx.lineTo(48,-10);ctx.lineTo(66,20);ctx.lineTo(52,60);ctx.setLineDash([400*crack,400]);gs(4,'#ff5a3c',12);ctx.setLineDash([])}ctx.restore()}
function totka(x,y,s,a,t){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.rotate(0.12*Math.sin(t*1.8));ctx.scale(s,s);ctx.beginPath();ctx.moveTo(0,-90);ctx.lineTo(0,150);gs(2.5,'rgba(243,236,228,.7)');
