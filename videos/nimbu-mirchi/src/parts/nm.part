function trishul(x,y,s,a){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.scale(s,s);ctx.beginPath();ctx.moveTo(0,-120);ctx.lineTo(0,160);ctx.moveTo(-50,-90);ctx.quadraticCurveTo(-50,-30,0,-30);ctx.quadraticCurveTo(50,-30,50,-90);gs(6,LN,10);
 for(const px of[-50,0,50]){ctx.beginPath();ctx.moveTo(px-12,px?-86:-116);ctx.lineTo(px,px?-120:-150);ctx.lineTo(px+12,px?-86:-116);ctx.fillStyle=LN;ctx.fill()}ctx.beginPath();ctx.moveTo(-14,10);ctx.quadraticCurveTo(0,30,14,10);ctx.quadraticCurveTo(0,40,-14,10);gs(3,OR,10);ctx.restore()}
function thirdEye(x,y,s,a,open,t){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.rotate(Math.PI/2);ctx.scale(s,s);ctx.beginPath();ctx.moveTo(-60,0);ctx.quadraticCurveTo(0,-40*open-2,60,0);ctx.quadraticCurveTo(0,40*open+2,-60,0);ctx.fillStyle='rgba(255,200,120,.9)';ctx.shadowColor=OR;ctx.shadowBlur=30*open;ctx.fill();ctx.shadowBlur=0;gs(4,OR,14);
 if(open>0.3){ctx.beginPath();ctx.arc(0,0,16*open,0,7);ctx.fillStyle='#ff4a1a';ctx.fill()}ctx.restore()}
