// ornate Kirtimukha: lion face with flaming mane, horns, bulging eyes, tongue and fangs (no body)
function kirti(x,y,s,a,t,glow=0){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.scale(s,s);
 if(glow>0){const g=ctx.createRadialGradient(0,0,0,0,0,300);g.addColorStop(0,`rgba(255,160,60,${0.45*glow})`);g.addColorStop(1,'rgba(255,120,20,0)');ctx.fillStyle=g;ctx.fillRect(-320,-320,640,640)}
 ctx.beginPath();for(let i=0;i<=40;i++){const an=Math.PI*(1.05+0.9*i/40);const R=i%2?170:215+10*Math.sin(t*3+i);ctx.lineTo(Math.cos(an)*R,Math.sin(an)*R+20)}
 for(let i=0;i<=16;i++){const an=Math.PI*(1.95+0.1+0.85*i/16);const R=i%2?150:180;ctx.lineTo(Math.cos(an)*R*0.9,Math.sin(an)*R*0.6+40)}ctx.closePath();ctx.fillStyle='rgba(255,138,31,.25)';ctx.fill();gs(4,OR,16);
 for(let i=0;i<9;i++){const an=Math.PI*(1.12+0.76*i/8);ctx.beginPath();ctx.moveTo(Math.cos(an)*120,Math.sin(an)*120+20);ctx.quadraticCurveTo(Math.cos(an+0.15)*170,Math.sin(an+0.15)*170+20,Math.cos(an)*190,Math.sin(an)*190+20);gs(3,GOLD,8)}
 ctx.beginPath();ctx.ellipse(0,20,120,118,0,0,7);ctx.fillStyle='rgba(22,14,10,.98)';ctx.fill();gs(5,LN,6);
 for(const d of[-1,1]){ctx.beginPath();ctx.moveTo(d*40,-86);ctx.quadraticCurveTo(d*90,-170,d*40,-200);ctx.quadraticCurveTo(d*70,-150,d*20,-96);ctx.fillStyle='rgba(243,236,228,.85)';ctx.fill();gs(3,LN);
  ctx.beginPath();ctx.ellipse(d*48,-14,30,26,0,0,7);ctx.fillStyle='#fff';ctx.fill();gs(4,OR,10);ctx.beginPath();ctx.arc(d*48,-12,13,0,7);ctx.fillStyle='#120a05';ctx.fill();
  ctx.beginPath();ctx.moveTo(d*14,-50);ctx.quadraticCurveTo(d*48,-64,d*84,-44);gs(7,OR,10);ctx.beginPath();ctx.arc(d*36,28,14,0,7);gs(4,LN)}
 ctx.beginPath();ctx.arc(0,-60,10,0,7);ctx.fillStyle=OR;ctx.fill();
 ctx.beginPath();ctx.moveTo(-70,56);ctx.quadraticCurveTo(0,30,70,56);ctx.quadraticCurveTo(60,110,0,116);ctx.quadraticCurveTo(-60,110,-70,56);ctx.fillStyle='#1a0505';ctx.fill();gs(4,LN);
 for(const d of[-1,1]){ctx.beginPath();ctx.moveTo(d*52,56);ctx.lineTo(d*44,96);ctx.lineTo(d*36,58);ctx.fillStyle='#fff';ctx.fill()}
 ctx.beginPath();ctx.moveTo(-24,80);ctx.quadraticCurveTo(-28,170+8*Math.sin(t*3),0,190+8*Math.sin(t*3));ctx.quadraticCurveTo(28,170+8*Math.sin(t*3),24,80);ctx.fillStyle='#d8303a';ctx.fill();gs(3,'#ff8a8a',8);ctx.restore()}
