  ctx.beginPath();ctx.moveTo(d*10,20);ctx.quadraticCurveTo(d*70,10,d*96,40);gs(8,LN)}
 ctx.beginPath();ctx.moveTo(-50,56);ctx.quadraticCurveTo(0,40,50,56);ctx.lineTo(30,70);ctx.lineTo(-30,70);ctx.closePath();ctx.fillStyle='#111';ctx.fill();gs(3,LN);
