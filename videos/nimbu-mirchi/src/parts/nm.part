 ctx.save();ctx.clip();ctx.fillStyle='rgba(255,138,31,.35)';ctx.fillRect(-100,30+Math.sin(t*3)*4,200,90);ctx.restore();for(let i=0;i<4;i++){const ph=(t*0.8+i/4)%1;ctx.beginPath();ctx.arc(-30+i*20,90-ph*120,5+3*ph,0,7);gs(2,GOLD)}rr(-34,-124,68,14,4);gs(4,LN);ctx.restore()}
