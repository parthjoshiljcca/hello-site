function rahuHead(x,y,s,a,bow){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.rotate(bow*0.5);ctx.scale(s,s);ctx.beginPath();ctx.arc(0,0,70,0,7);ctx.fillStyle='rgba(30,26,40,.97)';ctx.fill();gs(4,'rgba(170,160,200,.9)',8);
 ctx.beginPath();ctx.moveTo(-50,-50);ctx.lineTo(-30,-100);ctx.lineTo(-10,-60);ctx.lineTo(10,-110);ctx.lineTo(28,-60);ctx.lineTo(48,-100);ctx.lineTo(54,-46);ctx.fillStyle='rgba(255,177,92,.6)';ctx.fill();
 ctx.beginPath();ctx.arc(-24,-6,8,0,7);ctx.arc(24,-6,8,0,7);ctx.fillStyle=bow>0.5?'rgba(243,236,228,.6)':'#ff4a1a';ctx.fill();ctx.beginPath();ctx.moveTo(-30,34);ctx.quadraticCurveTo(0,bow>0.5?24:44,30,34);gs(4,LN);ctx.restore()}
// creature body: a long lion-serpent body behind the face; `eaten` 0..1 removes it from the tail end
function creature(x,y,s,a,t,eaten){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.scale(s,s);const keep=1-eaten;
 if(keep>0.02){ctx.beginPath();const N=60;for(let i=0;i<=N*keep;i++){const u=i/N;const px=-40-u*520,py=60+Math.sin(u*9+t*2)*50*u;i?ctx.lineTo(px,py):ctx.moveTo(px,py)}ctx.lineCap='round';gs(54,'rgba(255,138,31,.35)');
  ctx.beginPath();for(let i=0;i<=N*keep;i++){const u=i/N;const px=-40-u*520,py=60+Math.sin(u*9+t*2)*50*u;i?ctx.lineTo(px,py):ctx.moveTo(px,py)}gs(4,GOLD,12)}
 ctx.restore();kirti(x,y,s*0.55,a,t,0)}
