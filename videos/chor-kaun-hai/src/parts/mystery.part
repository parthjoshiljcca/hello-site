 ctx.beginPath();ctx.moveTo(-8,0);ctx.lineTo(-len*spread,-len);ctx.lineTo(len*spread,-len);ctx.lineTo(8,0);ctx.closePath();ctx.fillStyle=g;ctx.fill();ctx.restore()}
