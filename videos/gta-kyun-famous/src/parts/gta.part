// ---------- GTA primitives (original line art; no logos or game art) ----------
function carTop(x,y,s,a,rot,col){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.rotate(rot||0);ctx.scale(s,s);rr(-16,-9,32,18,4);ctx.fillStyle=col||OR;ctx.fill();rr(-6,-7,12,14,3);ctx.fillStyle='rgba(10,8,7,.7)';ctx.fill();ctx.restore()}
function crt(x,y,s,a,screen){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.scale(s,s);rr(-90,-70,180,140,14);ctx.fillStyle='rgba(30,22,16,.98)';ctx.fill();gs(3,LN);rr(-74,-56,148,104,10);ctx.fillStyle='#0d1a14';ctx.fill();ctx.save();rr(-74,-56,148,104,10);ctx.clip();if(screen)screen();ctx.restore();rr(-40,70,80,16,4);ctx.fillStyle='rgba(30,22,16,.98)';ctx.fill();gs(2.5,LN);ctx.restore()}
function clapper(x,y,s,a){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.scale(s,s);rr(-60,-20,120,80,8);ctx.fillStyle='rgba(22,15,11,.96)';ctx.fill();gs(3,LN);ctx.save();ctx.translate(-60,-20);ctx.rotate(-0.25);rr(0,-24,120,24,4);ctx.fillStyle='rgba(243,236,228,.9)';ctx.fill();for(let i=0;i<4;i++){ctx.beginPath();ctx.moveTo(10+i*30,-24);ctx.lineTo(25+i*30,0);gs(6,'#1a0f06')}ctx.restore();ctx.restore()}
function radio(x,y,s,a,t){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.scale(s,s);rr(-70,-40,140,90,14);ctx.fillStyle='rgba(22,15,11,.96)';ctx.fill();gs(3,LN);ctx.beginPath();ctx.arc(-30,8,24,0,7);gs(3,OR,10);rr(10,-14,48,8,4);ctx.fillStyle=GOLD;ctx.fill();rr(10,4,48,8,4);ctx.fillStyle='rgba(243,236,228,.4)';ctx.fill();ctx.beginPath();ctx.moveTo(40,-40);ctx.lineTo(60,-80);gs(3,LN);
 for(let k=0;k<3;k++){const ph=(t*1.2+k/3)%1;ctx.beginPath();ctx.arc(60,-80,10+ph*40,-1.2,-0.2);ctx.globalAlpha=a*(1-ph);gs(3,OR,8)}ctx.restore()}
function mask(x,y,s,a){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.scale(s,s);ctx.beginPath();ctx.moveTo(-50,-40);ctx.quadraticCurveTo(0,-60,50,-40);ctx.quadraticCurveTo(56,30,0,50);ctx.quadraticCurveTo(-56,30,-50,-40);ctx.fillStyle='rgba(255,177,92,.25)';ctx.fill();gs(3,GOLD,10);ctx.beginPath();ctx.ellipse(-20,-10,10,6,0,0,7);ctx.ellipse(20,-10,10,6,0,0,7);ctx.fillStyle='#1a0f06';ctx.fill();ctx.beginPath();ctx.arc(0,12,20,0.2,Math.PI-0.2);gs(4,'#1a0f06');ctx.restore()}
function pad(x,y,s,a){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.scale(s,s);ctx.beginPath();ctx.moveTo(-80,-30);ctx.quadraticCurveTo(0,-44,80,-30);ctx.quadraticCurveTo(110,40,80,50);ctx.quadraticCurveTo(50,56,30,20);ctx.lineTo(-30,20);ctx.quadraticCurveTo(-50,56,-80,50);ctx.quadraticCurveTo(-110,40,-80,-30);ctx.fillStyle='rgba(22,15,11,.96)';ctx.fill();gs(3,LN);
 ctx.fillStyle=OR;ctx.fillRect(-58,-6,28,8);ctx.fillRect(-48,-16,8,28);[[50,-14],[62,-2],[50,10],[38,-2]].forEach(([u,v])=>{ctx.beginPath();ctx.arc(u,v,5,0,7);ctx.fill()});ctx.restore()}
function infinity(x,y,s,a,t){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.scale(s,s);ctx.beginPath();for(let i=0;i<=80;i++){const u=i/80*Math.PI*2;const d=1+Math.sin(u)**2;ctx.lineTo(60*Math.cos(u)/d,60*Math.sin(u)*Math.cos(u)/d)}gs(5,OR,16);const u=t*2%(Math.PI*2),d=1+Math.sin(u)**2;ctx.beginPath();ctx.arc(60*Math.cos(u)/d,60*Math.sin(u)*Math.cos(u)/d,7,0,7);ctx.fillStyle=GOLD;ctx.fill();ctx.restore()}
function skyline(x,y,s,a){if(a<=0)return;ctx.save();ctx.globalAlpha*=a;ctx.translate(x,y);ctx.scale(s,s);const B=[[-70,60],[-48,100],[-24,70],[0,120],[24,80],[48,96],[70,56]];B.forEach(([bx,h])=>{rr(bx-11,-h,22,h,2);ctx.fillStyle='rgba(22,15,11,.96)';ctx.fill();gs(2,LN);for(let k=0;k<h/18-1;k++){ctx.fillStyle=k%2?GOLD:'rgba(255,177,92,.4)';ctx.fillRect(bx-5,-h+8+k*18,4,6)}});ctx.restore()}

// ---------- scenes ----------
function S0(t,lt){badge(300,1255,'13 SAAL KA INTEZAAR',pop(t,'gta6',0.45,0),{fs:26});badge(780,1255,'ITNI PAAGAL KYUN?',pop(t,'paagal',0.45,0),{fs:26})}
function S1(t,lt){ // 1997 · DMA Design · Scotland
 const a=eo(seg(lt,0,0.5));crt(540,930,2.1,a,()=>{txt('1997',0,-16,'900 52px J',OR,'center',18);txt('DMA DESIGN',0,30,'800 22px J','#7cc46b')});
 monoTag(540,690,'SCOTLAND · DUNDEE',fin(t,'scotland',0.4,0));badge(540,1255,'EK CHHOTI SI COMPANY',pop(t,'dma',0.45,0),{fs:28});
}
function S2(t,lt){ // top-down 2D game
 const a=eo(seg(lt,0,0.5));crt(540,930,2.4,a,()=>{ctx.fillStyle='#163024';ctx.fillRect(-74,-56,148,104);ctx.fillStyle='#2b2b2b';for(let i=-1;i<=1;i++){ctx.fillRect(-74,i*34-5,148,10);ctx.fillRect(i*48-5,-56,10,104)}
  ctx.fillStyle='rgba(255,177,92,.5)';for(let i=-1;i<=1;i++)for(let j=-1;j<=1;j++)ctx.fillRect(i*48+9,j*34+8,26,14);const u=(lt*0.25)%1;carTop(lerp(-70,70,u),-1,0.4,1,0,OR);carTop(-1,lerp(50,-50,(lt*0.33)%1),0.4,1,Math.PI/2,'#7cc4ff')});
 monoTag(540,690,'UPAR SE DIKHNE WALA',fin(t,'upar',0.4,-0.1));badge(540,1255,'SEEDHA SAADHA 2D',pop(t,'d2',0.45,0),{fs:30});
}
