function S6(t,lt){ // cyber cafe
 const a=eo(seg(lt,0,0.5));const code='HESOYAM';const n=Math.min(code.length,Math.floor(seg(t,E('cheat')-0.3,E('cheat')+1.2)*code.length+0.001));
 for(let i=0;i<3;i++){const on=i===1;crt(240+i*300,920,1.3,a,()=>{ctx.fillStyle=on?'#0f2a1d':'#101a16';ctx.fillRect(-74,-56,148,104);skyline(0,40,0.6,0.7);if(on){txt(code.slice(0,n)+(Math.sin(t*8)>0?'_':''),0,-30,'900 22px J','#7cc46b','center',10)}})}
 for(let i=0;i<3;i++)stickman(240+i*300,1110,0.9,a);
 monoTag(540,690,'VICE CITY 2002 · SAN ANDREAS 2004',fin(t,'vice',0.4,-0.1));badge(540,1255,'CHEAT CODES RATKE',pop(t,'cheat',0.45,0.3),{fs:28});
}
function S7(t,lt){ // film, radio, satire
 const f=pop(t,'films',0.45,-0.15),r=pop(t,'radio',0.45,-0.15),s=pop(t,'america',0.45,-0.15);
 card(200,920,300,340,f,'',null,t);clapper(200,890,1.1,cl(f));if(f>0)txt('FILM JAISI KAHANI',200,1050,'800 20px M',OR);
 card(540,920,300,340,r,'',null,t);radio(540,910,1.1,cl(r),t);if(r>0)txt('RADIO STATIONS',540,1050,'800 20px M',OR);
 card(880,920,300,340,s,'',null,t);mask(880,890,1.1,cl(s));if(s>0)txt('SATIRE',880,1050,'800 20px M',OR);
 badge(540,1255,'GAME KAM, ZINDA SHEHAR ZYADA',pop(t,'zinda',0.45,0),{fs:24});
}
function S8(t,lt){ // $1B in 3 days
 const a=eo(seg(lt,0,0.5));const p=seg(t,E('teen')-0.3,E('arab')+0.5);const v=Math.round(1000*eio(p));
 card(540,900,760,440,a,'',null,t);if(a>0){ctx.save();ctx.globalAlpha*=a;txt('GTA V · 2013',540,740,'800 26px J',GOLD);txt('$'+(v*1e6).toLocaleString('en-US'),540,830,'900 70px M',OR,'center',26);
  for(let d=0;d<3;d++){const q=cl(p*3-d);rr(250+d*200,960,160,40,10);ctx.fillStyle='rgba(243,236,228,.1)';ctx.fill();rr(250+d*200,960,160*q,40,10);ctx.fillStyle=OR;ctx.fill();txt('DIN '+(d+1),330+d*200,1030,'500 20px J','rgba(243,236,228,.7)')}ctx.restore()}
 badge(540,1255,'3 DIN · 1 ARAB DOLLAR',pop(t,'arab',0.45,0),{fs:28});
}
function S9(t,lt){ // 23 crore copies
 const a=eo(seg(lt,0,0.5));const p=eo(seg(t,E('crore')-0.6,E('copies')+0.8));
 for(let i=0;i<23;i++){const q=cl(p*23-i);if(q<=0)continue;const col=i%2;ctx.save();ctx.globalAlpha*=a*q;ctx.beginPath();ctx.ellipse(540+(col?18:-18),1190-i*16,120,20,0,0,7);ctx.fillStyle=i===22?'rgba(255,138,31,.6)':'rgba(243,236,228,.18)';ctx.fill();gs(2,i===22?OR:'rgba(243,236,228,.6)',i===22?16:0);ctx.restore()}
 const n=Math.round(23*p);txt(n+' CRORE+',540,690,'900 80px M',OR,'center',24);monoTag(540,760,'GTA V · COPIES SOLD',a);
 badge(540,1255,'23 CRORE SE ZYADA',pop(t,'crore',0.45,0),{fs:30});
}
