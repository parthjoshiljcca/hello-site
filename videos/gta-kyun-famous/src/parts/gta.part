function S13(t,lt){ // Rockstar: years of work, detail
 const a=eo(seg(lt,0,0.5));const Y=[['1997','GTA'],['2001','GTA III'],['2004','SAN ANDREAS'],['2008','GTA IV'],['2013','GTA V'],['2026','GTA VI']];const p=seg(t,E('rockstar')-0.4,E('mehnat')+1.0);
 ctx.save();ctx.globalAlpha*=a;ctx.beginPath();ctx.moveTo(130,900);ctx.lineTo(lerp(130,950,p),900);gs(4,OR,10);ctx.restore();
 Y.forEach(([y,n],i)=>{const q=back(cl(p*6-i));const x=130+i*164;if(q<=0)return;ctx.save();ctx.globalAlpha*=a*cl(q);ctx.beginPath();ctx.arc(x,900,14*q,0,7);ctx.fillStyle=i===5?OR:WH;ctx.fill();txt(y,x,i%2?960:840,'800 26px J',i===5?OR:WH);txt(n,x,i%2?995:805,'500 16px J','rgba(243,236,228,.7)');ctx.restore()});
 const d=fin(t,'detail',0.5,-0.2);if(d>0){ctx.save();ctx.globalAlpha*=d;ctx.translate(800,1080);ctx.beginPath();ctx.arc(0,0,60,0,7);gs(6,LN);ctx.beginPath();ctx.moveTo(42,42);ctx.lineTo(90,90);gs(12,LN);txt('DETAIL',0,2,'800 20px J',GOLD);ctx.restore()}
 monoTag(540,690,'ROCKSTAR GAMES · 1998',fin(t,'rockstar',0.4,0));badge(540,1255,'SAALON KI MEHNAT',pop(t,'mehnat',0.45,0),{fs:28});
}
