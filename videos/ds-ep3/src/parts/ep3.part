function S13(t,lt){badge(540,1255,'HEAD SE EK EK HOP',pop(t,'follow',0.45,0),{fs:28})}
function S14(t,lt){badge(540,1255,'ACCESS · O(n)',pop(t,'bigon',0.45,0),{fs:30})}
function S15(t,lt){ // extra memory: array cell vs node
 const a=eo(seg(lt,0,0.5));const e=fin(t,'extra',0.5,-0.2);
 card(290,900,400,440,a,'',null,t);card(790,900,400,440,a,'',null,t);
 if(a>0){ctx.save();ctx.globalAlpha*=a;txt('ARRAY',290,730,'900 40px M',WH);txt('NODE',790,730,'900 40px M',OR,'center',14);ctx.restore();
  cellBox(290,900,150,120,a,'7',false);txt('SIRF DATA',290,1050,'500 22px J','rgba(243,236,228,.7)');
  nodeBox(790,900,a,'7',false,{w:250,h:120,lab:true,ptrHot:e>0.5});txt('DATA + POINTER',790,1060,'500 22px J',GOLD)}
 if(e>0){ctx.save();ctx.globalAlpha*=e;rr(790+250/2-85-6,900-60-6,97,132,14);gs(4,GOLD,30*(0.6+0.4*Math.sin(t*6)));txt('+ EXTRA',832,995,'800 24px M',GOLD,'center',12);ctx.restore()}
 badge(540,1255,'POINTER = EXTRA MEMORY',pop(t,'extra',0.45,0),{fs:26});
}
function S16(t,lt){ // uses
 const m=pop(t,'music',0.45,-0.15),b=pop(t,'browser',0.45,-0.15);
 const nh=t>E('next')-0.1&&t<E('next')+0.5?0:(t>E('next')+0.5&&t<E('next')+1.1?1:-1);
 const bh=t>E('back')-0.1&&t<E('back')+0.6?0:(t>E('back')+0.6&&t<E('back')+1.4?1:-1);
 playerCard(290,900,m,t,nh);browserCard(790,900,b,t,bh);
 if(m>0)txt('MUSIC PLAYER',290,1170,'900 28px M',OR);if(b>0)txt('BROWSER',790,1170,'900 28px M',OR);
}
function S17(t,lt){badge(540,1255,'DOUBLY LINKED LIST',pop(t,'doubly',0.45,0),{fs:30})}
function S18(t,lt){ // recap table
 const rows=[['INSERT (jagah pata)','O(1)','TEZ',1,'jodna',-0.6],['DELETE (jagah pata)','O(1)','TEZ',1,'tez',-0.3],['ACCESS · SEARCH','O(n)','DHEEMA',0,'pahunchna',-0.1],['EXTRA MEMORY','POINTER','',0,'dheema2',0.1]];
 rows.forEach(([n,o,s,good,e,off],i)=>{const p=pop(t,e,0.45,off);const y=720+i*130;card(540,y,860,110,p,'',null,t);if(p>0){ctx.save();ctx.globalAlpha*=cl(p);txt(n,150,y+2,'800 32px M',WH,'left');txt(o,660,y+2,`900 ${o.length>4?30:40}px M`,good?OR:'#ff5a3c','center',good?16:0);txt(s,870,y+2,'800 28px M',good?GOLD:'rgba(243,236,228,.7)','center');ctx.restore()}});
}
function S19(t,lt){ // next: stack
 const a=eo(seg(lt,0,0.5));card(540,900,640,440,a,'',null,t);if(a>0){ctx.save();ctx.globalAlpha*=a;txt('EP 04',540,740,'900 40px J',GOLD);txt('STACK',540,830,'900 96px M',OR,'center',30);ctx.restore();
  const n=Math.min(6,Math.floor(seg(t,E('plates')-0.4,E('plates')+0.8)*6)+1);plates2D(540,1060,1.3,a,n);
  const top=fin(t,'series',0.5,-0.4);if(top>0)arrow(700,1060-n*21,700,940-n*21,top,OR,4);monoTag(830,1000-n*21,'LAST IN · FIRST OUT',top)}
 badge(540,1255,'AGLE EPISODE MEIN',pop(t,'stack',0.45,0),{fs:30});
}
function S20(t,lt){ // comments
 const a=eo(seg(lt,0,0.5));chain(150,1060,200,['?','?','?','?'],a,1,Math.floor(t*2)%4,{w:140});
 speech(540,800,1.4,pop(t,'comments',0.45,-0.8),false,t);badge(540,1255,'COMMENTS MEIN BATAO',pop(t,'comments',0.45,0),{fs:30});
}
const SCN=[S0,S1,S2,S3,S4,S5,S6,S7,S8,S9,S10,S11,S12,S13,S14,S15,S16,S17,S18,S19,S20];
